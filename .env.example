# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=leadforge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# App Settings
# Generate one with: openssl rand -hex 32. The app refuses to boot in
# production (ENV=production) with the placeholder below.
SECRET_KEY=leadforge-secret-key-production-change-me
ENV=dev
# Browser origins allowed to call the API. "*" is fine locally; production
# must name the dashboard, e.g. CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=*
# Optional: rotating egress proxies for directory scraping, comma-separated.
PROXY_LIST=
API_V1_STR=/api/v1
TRACKING_DOMAIN=http://localhost:8000
